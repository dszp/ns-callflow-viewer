{
  // Type-checks the DEPLOYABLE Worker surface only (`pnpm typecheck`). The Node-using files —
  // cli.ts and *.selftest.ts — are excluded (they'd need @types/node); wrangler/esbuild bundles
  // without type-checking, so this is the gate that catches type errors in shipped Worker code.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // brand.ts imports package.json for VERSION: one source of truth, no drift.
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  // Selftests run under tsx, which does not typecheck them. They use Node globals and WebCrypto
  // shapes the Workers types narrow differently, so including them here produces noise that hides
  // real errors in the code that actually ships.
  "exclude": [
    // Selftests run under tsx, which does not typecheck them. They use Node globals and WebCrypto
    // shapes the Workers types narrow differently, so including them here produces noise that hides
    // real errors in the code that actually ships.
    "src/**/*.selftest.ts",
    // cli.ts is a NODE program (fs/path), not Worker code. Typechecking it here would mean pulling
    // @types/node into the same project as @cloudflare/workers-types, where the two disagree about
    // globals like `fetch` — which is how a Worker file ends up silently typechecked against Node's
    // lenient shapes. It runs under tsx and is exercised by `pnpm flow` against the fixture.
    "src/cli.ts"
  ]
}
