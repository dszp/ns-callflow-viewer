{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ns-callflow-viewer",
  "main": "src/worker.ts",
  "compatibility_date": "2025-07-01",
  "observability": { "enabled": true },

  // ─────────────────────────────────────────────────────────────────────────────────────────────────
  // PLACEHOLDERS. Copy this file, fill in your own values, and deploy with `-c <your-copy>.jsonc`.
  // Nothing real is committed here on purpose: `NS_SERVER` says which provider you run on, and a
  // route says which hostname you serve — both are your business information, not this project's.
  //
  // ⚠️ ACCESS_AUD + ACCESS_TEAM_DOMAIN are REQUIRED in practice, not optional. Without BOTH, this
  // Worker refuses to use its stored credential at all and serves setup instructions instead. That is
  // enforced in src/exposure.ts, not advice. See CONFIG.md.
  // ─────────────────────────────────────────────────────────────────────────────────────────────────
  "vars": {
    "NS_SERVER": "api.example.com",

    // Cache-key namespace for THIS deployment. `caches.default` is shared ZONE-WIDE, not per Worker,
    // so two deployments on one zone at the same scope read and write one set of cache entries —
    // each serving the other's data. One Worker: leave it alone.
    "CACHE_SCOPE": "default"

    // "ACCESS_AUD": "<your Access application's AUD tag>",
    // "ACCESS_TEAM_DOMAIN": "yourteam.cloudflareaccess.com",
    // "ALLOWED_DOMAINS": "acme.example",
    // "NS_DEVICE_DETAILS": "1"
  }

  // Secrets are never in this file. Set them with:
  //   wrangler secret put NS_API_KEY
  //   wrangler secret put RINGOTEL_API_KEY     (optional — app presence on agent lines)
}
